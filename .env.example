# Copy to .env.local (dev) or set in Coolify > Environment Variables (prod).

# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://wcsejeuqqeepgrprcrde.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public URL of this app; used in sign-in email links and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true after enabling Google in Supabase > Authentication > Sign In / Providers (build-time).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Local only, for `npm run email:push`. Never add it to Coolify.
# SUPABASE_ACCESS_TOKEN=sbp_...

# --- AI models (any without a key shows as "no key" in the picker) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the model each provider uses.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-6.1-sol
# XAI_MODEL=grok-4.7
# MOONSHOT_MODEL=kimi-k3
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# GEMINI_MODEL=gemini-flash-latest
# OPENROUTER_MODEL=openrouter/auto

# Notifications (server only unless NEXT_PUBLIC_)
# Service role: used only by /api/notifications/deliver (called by the database).
SUPABASE_SERVICE_ROLE_KEY=
# Shared with the database (Supabase Vault secret "notify_secret"): signs the
# delivery call and hashes verification codes. Same value everywhere.
NOTIFY_SECRET=
# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Email (Resend) and SMS (Twilio)
RESEND_API_KEY=
# Signing secret (whsec_...) of the Resend webhook for inbound email
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Admin browser phone (Communications -> Calls): an API key and a TwiML App
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# Stripe (test keys first: sk_test_ / pk_test_). Webhook secret from the
# Stripe dashboard (or `stripe listen`). Products: npm run stripe:setup
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Only if your Anthropic key isn't scoped to a workspace:
ANTHROPIC_WORKSPACE_ID=

# Scheduled task: GET /api/cron/comms with "Authorization: Bearer <CRON_SECRET>" every 5 minutes
CRON_SECRET=
