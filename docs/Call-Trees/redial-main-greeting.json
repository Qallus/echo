{
  "schema": 1,
  "name": "Redial main Greeting",
  "settings": {
    "timezone": "America/Phoenix",
    "recording": "off",
    "onUnconnected": "ai_or_voicemail",
    "voice": {
      "provider": "gemini",
      "id": "Despina"
    }
  },
  "start": "incoming",
  "nodes": [
    {
      "id": "incoming",
      "type": "trigger.call",
      "label": "Incoming call",
      "pos": [
        0,
        0
      ],
      "config": {},
      "next": {
        "next": "lookup"
      }
    },
    {
      "id": "lookup",
      "type": "crm_lookup",
      "label": "Client lookup",
      "pos": [
        0,
        200
      ],
      "config": {},
      "next": {
        "found": "greeting",
        "notFound": "greeting"
      }
    },
    {
      "id": "greeting",
      "type": "say",
      "label": "Main greeting",
      "pos": [
        0,
        400
      ],
      "config": {
        "prompt": {
          "text": "Thank you for calling Redial."
        },
        "loop": 1
      },
      "next": {
        "next": "menu"
      }
    },
    {
      "id": "menu",
      "type": "gather",
      "label": "Main menu",
      "pos": [
        0,
        600
      ],
      "config": {
        "prompt": {
          "text": "If you know your party's extension, please dial it at any time. For sales, press 1. For support, press 2. To speak to our business team, press 3. To speak to our residential team, press 4. For a dial by name directory, press 5. To speak to an operator, press 0."
        },
        "input": [
          "dtmf"
        ],
        "timeout": 6,
        "extensions": true,
        "options": [
          {
            "out": "sales",
            "key": "1"
          },
          {
            "out": "support",
            "key": "2"
          },
          {
            "out": "business",
            "key": "3"
          },
          {
            "out": "residential",
            "key": "4"
          },
          {
            "out": "directory",
            "key": "5"
          },
          {
            "out": "operator",
            "key": "0"
          }
        ]
      },
      "next": {
        "sales": "team_sales",
        "support": "team_support",
        "business": "team_business",
        "residential": "team_residential",
        "directory": "team_directory",
        "operator": "team_operator"
      }
    },
    {
      "id": "team_sales",
      "type": "set",
      "label": "Sales",
      "pos": [
        -800,
        800
      ],
      "config": {
        "vars": [
          {
            "key": "team",
            "value": "Sales"
          }
        ]
      },
      "next": {
        "next": "script_sales"
      }
    },
    {
      "id": "script_sales",
      "type": "say",
      "label": "Sales script",
      "pos": [
        -800,
        1000
      ],
      "config": {
        "prompt": {
          "text": "Thanks for your interest in Redial. Connecting you with sales now."
        },
        "loop": 1
      },
      "next": {
        "next": "ring"
      }
    },
    {
      "id": "team_support",
      "type": "set",
      "label": "Support",
      "pos": [
        -480,
        800
      ],
      "config": {
        "vars": [
          {
            "key": "team",
            "value": "Support"
          }
        ]
      },
      "next": {
        "next": "script_support"
      }
    },
    {
      "id": "script_support",
      "type": "say",
      "label": "Support script",
      "pos": [
        -480,
        1000
      ],
      "config": {
        "prompt": {
          "text": "You've reached Redial support. Connecting you now."
        },
        "loop": 1
      },
      "next": {
        "next": "ring"
      }
    },
    {
      "id": "team_business",
      "type": "set",
      "label": "Business",
      "pos": [
        -160,
        800
      ],
      "config": {
        "vars": [
          {
            "key": "team",
            "value": "Business"
          }
        ]
      },
      "next": {
        "next": "script_business"
      }
    },
    {
      "id": "script_business",
      "type": "say",
      "label": "Business script",
      "pos": [
        -160,
        1000
      ],
      "config": {
        "prompt": {
          "text": "Connecting you with the Redial business team."
        },
        "loop": 1
      },
      "next": {
        "next": "ring"
      }
    },
    {
      "id": "team_residential",
      "type": "set",
      "label": "Residential",
      "pos": [
        160,
        800
      ],
      "config": {
        "vars": [
          {
            "key": "team",
            "value": "Residential"
          }
        ]
      },
      "next": {
        "next": "script_residential"
      }
    },
    {
      "id": "script_residential",
      "type": "say",
      "label": "Residential script",
      "pos": [
        160,
        1000
      ],
      "config": {
        "prompt": {
          "text": "Connecting you with the Redial residential team."
        },
        "loop": 1
      },
      "next": {
        "next": "ring"
      }
    },
    {
      "id": "team_operator",
      "type": "set",
      "label": "Operator",
      "pos": [
        480,
        800
      ],
      "config": {
        "vars": [
          {
            "key": "team",
            "value": "Operator"
          }
        ]
      },
      "next": {
        "next": "script_operator"
      }
    },
    {
      "id": "script_operator",
      "type": "say",
      "label": "Operator script",
      "pos": [
        480,
        1000
      ],
      "config": {
        "prompt": {
          "text": "One moment while I connect you."
        },
        "loop": 1
      },
      "next": {
        "next": "ring"
      }
    },
    {
      "id": "team_directory",
      "type": "set",
      "label": "Directory",
      "pos": [
        800,
        800
      ],
      "config": {
        "vars": [
          {
            "key": "team",
            "value": "Directory"
          }
        ]
      },
      "next": {
        "next": "dial_by_name"
      }
    },
    {
      "id": "dial_by_name",
      "type": "directory",
      "label": "Dial by name",
      "pos": [
        800,
        1000
      ],
      "config": {
        "prompt": {
          "text": "Please say the name of the person you're trying to reach."
        },
        "ringSeconds": 25
      },
      "next": {
        "connected": "log_answered",
        "noAnswer": "log_missed",
        "notFound": "team_operator"
      }
    },
    {
      "id": "ring",
      "type": "connect",
      "label": "Ring Jeremy",
      "pos": [
        -320,
        1200
      ],
      "config": {
        "targets": [
          {
            "owner": true
          }
        ],
        "mode": "all",
        "ringSeconds": 25,
        "whisper": "Redial {{flow.team}} call.",
        "record": true
      },
      "next": {
        "connected": "log_answered",
        "noAnswer": "log_missed",
        "busy": "log_missed",
        "failed": "log_missed"
      }
    },
    {
      "id": "log_answered",
      "type": "crm_update",
      "label": "Log answered call",
      "pos": [
        0,
        1200
      ],
      "config": {
        "note": "{{flow.team}} call from {{call.from}}, answered.",
        "tags": [
          "Phone"
        ],
        "createLead": true,
        "interest": "{{flow.team}}"
      },
      "next": {
        "next": "goodbye"
      }
    },
    {
      "id": "goodbye",
      "type": "hangup",
      "label": "Goodbye",
      "pos": [
        -160,
        1400
      ],
      "config": {},
      "next": {}
    },
    {
      "id": "log_missed",
      "type": "crm_update",
      "label": "Log missed call / new lead",
      "pos": [
        320,
        1200
      ],
      "config": {
        "note": "Missed {{flow.team}} call from {{call.from}}. The AI receptionist took it.",
        "tags": [
          "Phone"
        ],
        "createLead": true,
        "interest": "{{flow.team}}"
      },
      "next": {
        "next": "text_caller"
      }
    },
    {
      "id": "text_caller",
      "type": "message",
      "label": "Missed-call text",
      "pos": [
        160,
        1400
      ],
      "config": {
        "channel": "sms",
        "to": "{{call.from}}",
        "enabled": true,
        "body": "Thanks for calling Redial! Sorry we missed you. We'll get back to you shortly, or just reply to this text. Reply STOP to opt out."
      },
      "next": {
        "sent": "email_me",
        "failed": "email_me"
      }
    },
    {
      "id": "email_me",
      "type": "message",
      "label": "Email Jeremy",
      "pos": [
        0,
        1600
      ],
      "config": {
        "channel": "email",
        "to": "jw@redial.si",
        "enabled": true,
        "subject": "Missed {{flow.team}} call from {{call.from}}",
        "body": "Missed {{flow.team}} call on the Redial main line.\n\nCaller: {{call.callerName}} {{call.from}}\nIn the CRM as: {{flow.contact_name}} {{flow.company}}\nNew lead: {{flow.new_lead}}\n\nThe AI receptionist is taking the call. The recording, transcript and summary will be in Redial."
      },
      "next": {
        "sent": "assistant",
        "failed": "assistant"
      }
    },
    {
      "id": "assistant",
      "type": "ai",
      "label": "AI receptionist",
      "pos": [
        0,
        1800
      ],
      "config": {
        "instructions": "The caller asked for {{flow.team}}. Help them, take a message and offer a callback.",
        "intents": [],
        "maxMinutes": 10
      },
      "next": {
        "handoff": "goodbye",
        "error": "goodbye"
      }
    }
  ]
}